{
  "name": "adventura-ai-runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Private AI runtime service for Adventura backend LLM and RAG workloads.",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "node --import tsx --test \"tests/**/*.test.ts\"",
    "build:rag-index": "tsx scripts/build-lore-index.ts",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^25.0.3",
    "fast-check": "3.23.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0"
  }
}
