# Safe local defaults only. Inject real provider keys and runtime tokens through deployment secrets.
AI_RUNTIME_PORT=3100
# Safe default: local-only. Use 0.0.0.0 only when this machine must accept
# requests from a separate backend server.
AI_RUNTIME_HOST=127.0.0.1
# Optional. When set, private endpoints require Authorization: Bearer <token>.
# Required when AI_RUNTIME_HOST is 0.0.0.0 or any non-local address.
AI_RUNTIME_AUTH_TOKEN=
AI_LLM_BASE_URL=http://localhost:1234/v1
AI_LLM_MODEL=google/gemma-4-12b-qat
AI_LLM_API_KEY=local-dev-key
AI_LLM_TIMEOUT_MS=12000
# Reasoning effort for reasoning-capable models (e.g. Gemma 4 QAT). "none"
# disables chain-of-thought so short dialogue/assessment outputs stay fast.
# Set to a model-supported level (e.g. "low") to re-enable reasoning.
AI_LLM_REASONING_EFFORT=none
# Best-effort startup LLM warm-up. When true (and AI_LLM_MODEL is set), the runtime
# issues one tiny LLM probe after listen to avoid a cold-start delay on the first
# real request. Embedding warm-up always runs when RAG is configured.
AI_LLM_WARMUP_ENABLED=false
RAG_CORPUS_DIR=data/lore-corpus
RAG_POLICY_DIR=data/lore-policy
RAG_INDEX_FILE=data/lore-index/lore-embedding-index.json
RAG_RELEVANCE_THRESHOLD=0.2
RAG_TOP_K=4
RAG_REBUILD_INDEX_ON_MISSING=false
RAG_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
RAG_EMBEDDING_DIMENSION=384
# Max entries in the in-process query-embedding LRU cache. Default 256.
# Set to 0 to disable the embedding cache entirely.
RAG_EMBEDDING_CACHE_MAX=256
