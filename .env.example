# Safe local defaults only. Inject real provider keys and runtime tokens through deployment secrets.
AI_RUNTIME_PORT=3100
# Optional. When set, private endpoints require Authorization: Bearer <token>.
AI_RUNTIME_AUTH_TOKEN=
AI_LLM_BASE_URL=http://localhost:1234/v1
AI_LLM_MODEL=google/gemma-4-12b-qat
AI_LLM_API_KEY=local-dev-key
AI_LLM_TIMEOUT_MS=12000
RAG_CORPUS_DIR=data/lore-corpus
RAG_POLICY_DIR=data/lore-policy
RAG_INDEX_FILE=data/lore-index/lore-embedding-index.json
RAG_RELEVANCE_THRESHOLD=0.2
RAG_TOP_K=4
RAG_REBUILD_INDEX_ON_MISSING=false
RAG_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
RAG_EMBEDDING_DIMENSION=384
